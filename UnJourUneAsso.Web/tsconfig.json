{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "rootDir": "./src/Assets/Js",
    "outDir": "./public/js/dist",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": ["src/Assets/Js/**/*"],
  "exclude": ["node_modules", "dist"]
}
